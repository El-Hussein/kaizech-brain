# ============================================
# Kaizech Brain — Environment Configuration
# ============================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database — PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kaizech
DB_PASSWORD=kaizech_secret_2024
DB_DATABASE=kaizech_brain

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret-from-developer-console

# RAG Configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
