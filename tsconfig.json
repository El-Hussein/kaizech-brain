{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@kaizech/shared": ["libs/shared/src"],
      "@kaizech/shared/*": ["libs/shared/src/*"],
      "@kaizech/database": ["libs/database/src"],
      "@kaizech/database/*": ["libs/database/src/*"],
      "@kaizech/agent": ["libs/agent/src"],
      "@kaizech/agent/*": ["libs/agent/src/*"],
      "@kaizech/memory": ["libs/memory/src"],
      "@kaizech/memory/*": ["libs/memory/src/*"],
      "@kaizech/rag": ["libs/rag/src"],
      "@kaizech/rag/*": ["libs/rag/src/*"],
      "@kaizech/tools": ["libs/tools/src"],
      "@kaizech/tools/*": ["libs/tools/src/*"],
      "@kaizech/prompts": ["libs/prompts/src"],
      "@kaizech/prompts/*": ["libs/prompts/src/*"],
      "@kaizech/channels": ["libs/channels/src"],
      "@kaizech/channels/*": ["libs/channels/src/*"],
      "@kaizech/analytics": ["libs/analytics/src"],
      "@kaizech/analytics/*": ["libs/analytics/src/*"],
      "@kaizech/knowledge": ["libs/knowledge/src"],
      "@kaizech/knowledge/*": ["libs/knowledge/src/*"],
      "@kaizech/tickets": ["libs/tickets/src"],
      "@kaizech/tickets/*": ["libs/tickets/src/*"],
      "@kaizech/voice-onboarding": ["libs/voice-onboarding/src"],
      "@kaizech/voice-onboarding/*": ["libs/voice-onboarding/src/*"],
      "@kaizech/chat-core": ["libs/chat-core/src"],
      "@kaizech/chat-core/*": ["libs/chat-core/src/*"],
      "@kaizech/chat-react": ["libs/chat-react/src"],
      "@kaizech/chat-react/*": ["libs/chat-react/src/*"],
      "@kaizech/chat-react-native": ["libs/chat-react-native/src"],
      "@kaizech/chat-react-native/*": ["libs/chat-react-native/src/*"],
      "@husseinsalah96/chat-core": ["libs/chat-core/src"],
      "@husseinsalah96/chat-core/*": ["libs/chat-core/src/*"],
      "@husseinsalah96/chat-react": ["libs/chat-react/src"],
      "@husseinsalah96/chat-react/*": ["libs/chat-react/src/*"],
      "@husseinsalah96/chat-react-native": ["libs/chat-react-native/src"],
      "@husseinsalah96/chat-react-native/*": ["libs/chat-react-native/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
